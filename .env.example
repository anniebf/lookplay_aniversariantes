# Copie para ".env". O .env não vai para o Git.

# exemplo  = dados fictícios, nada é enviado ao Lookplay
# producao = consulta o Oracle e envia de verdade
MODO=exemplo

# --- Lookplay ---
LOOKPLAY_URL=https://SUA-EMPRESA.lookplay.tv/sistema
LOOKPLAY_USUARIO=
# Copiado do navegador após o login, ex.: PHPSESSID=abc123
LOOKPLAY_COOKIES=
# Filtros do Lookplay. Para testar sem afetar a TV, use ANIVERSARIANTES_2 e TEMPO_CASA_2.
LOOKPLAY_FILTRO_VIDA=ANIVERSARIANTES_3
LOOKPLAY_FILTRO_CASA=TEMPO_CASA_3
# Opcional. Sem senha, quando o cookie expirar é preciso colar outro.
LOOKPLAY_SENHA=

# --- Oracle (mesmos nomes do projeto anterior) ---
usernameBd=
passwordBd=
dsn=

# View de funcionários (SCHEMA.VIEW) e regras da empresa. Obrigatórias no MODO=producao,
# mesmo vazias, para as regras nunca mudarem sem aviso.
ORACLE_VIEW=
# Códigos de empresa (emp_protheus) que não entram, separados por vírgula. Ex.: 75,80
ORACLE_EMPRESAS_EXCLUIDAS=
# Seções que não entram: EMPRESA|SEÇÃO, separadas por ";". Ex.: 17|Conselho;16|Acionistas
ORACLE_SECOES_EXCLUIDAS=
# Seções exibidas com outro nome: EMPRESA|SEÇÃO=NOVO NOME, separadas por ";". Ex.: 17|Diretoria Geral=Diretoria
ORACLE_SECOES_RENOMEADAS=

# Filial em destaque e no topo do dashboard (nome exato). No modo exemplo: Matriz
FILIAL_MATRIZ=Matriz

# --- Dashboard: obrigatório no modo producao ---
DASHBOARD_USUARIO=admin
DASHBOARD_SENHA=

# --- Histórico das execuções ---
# Padrão: oracle no MODO=producao e sqlite (arquivo local) no MODO=exemplo.
# HISTORICO=oracle
# As tabelas são criadas sozinhas na primeira subida: <TABELA>, <TABELA>_ITENS, _PESSOAS e _EVENTOS.
HISTORICO_SCHEMA=RPA
HISTORICO_TABELA=LOOKPLAY_ANIVERSARIANTES

# --- Servidor (Docker) ---
# Porta publicada no servidor e fuso usado nos horários
PORTA=8765
TZ=America/Cuiaba

# --- Envio automático (o próprio servidor dispara) ---
# Dia (segunda...domingo), hora e quanto tempo depois ainda pode rodar se o servidor subir atrasado.
AGENDA_ATIVA=1
AGENDA_DIA=segunda
AGENDA_HORA=06:00
AGENDA_TOLERANCIA_MINUTOS=120

# --- Ajustes opcionais ---
PAUSA_ENTRE_ENVIOS=0.5
CACHE_CONSULTA_SEGUNDOS=300
